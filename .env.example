# Copiar a .env y ajustar. .env NO se versiona.
APP_PORT=8080

POSTGRES_DB=ticketera
POSTGRES_USER=ticketera
POSTGRES_PASSWORD=cambiar-esta-clave

RABBITMQ_USER=ticketera
RABBITMQ_PASSWORD=cambiar-esta-clave

# Clave para firmar los JWT (al menos 32 caracteres). Si no se define se usa un
# valor de desarrollo; en cualquier otro entorno generar una, por ejemplo con:
#   openssl rand -base64 48
# JWT_SECRET=

# Componente de IA. Por defecto "stub" (sin modelo).
# Para Gemma 4 E4B: levantar ticketera/ia/servidor.py y poner IA_GENERADOR=llm.
# La app en Docker usa host.docker.internal; Spring en el host usa localhost.
# HF_TOKEN solo lo lee el proceso de Python, si Hugging Face pide la licencia.
IA_GENERADOR=stub
# LLM_URL=http://host.docker.internal:8090
# LLM_MODEL=google/gemma-4-E4B-it
# HF_TOKEN=

# Deteccion de reclamos duplicados y zona horaria del municipio (opcionales).
# DUPLICADOS_HABILITADO=true
# ZONA_HORARIA=America/Argentina/Buenos_Aires

# Geocodificacion con Nominatim (OpenStreetMap). Email opcional de contacto,
# como pide su politica de uso.
GEO_HABILITADO=true
# GEO_CONTACTO=
