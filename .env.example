# Copiar a .env y ajustar. .env NO se versiona.
APP_PORT=8080

POSTGRES_DB=ticketera
POSTGRES_USER=ticketera
POSTGRES_PASSWORD=cambiar-esta-clave

RABBITMQ_USER=ticketera
RABBITMQ_PASSWORD=cambiar-esta-clave

# Componente de IA. Por defecto "stub" (sin credenciales ni costo).
# Para usar Gemini: IA_GENERADOR=llm y una API key de Google AI Studio.
IA_GENERADOR=stub
# LLM_API_KEY=
# LLM_MODEL=gemini-2.5-flash
# LLM_URL=https://generativelanguage.googleapis.com/v1beta

# Geocodificacion con Nominatim (OpenStreetMap). Email opcional de contacto,
# como pide su politica de uso.
GEO_HABILITADO=true
# GEO_CONTACTO=
