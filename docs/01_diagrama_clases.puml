@startuml 01_diagrama_clases
' Vista general: solo nombres y dependencias entre capas.
' Detalle (atributos, metodos, patrones) en:
'   01a_clases_dominio, 01b_clases_patrones, 01c_clases_servicios, 01d_clases_seguridad

title Ticketera Municipal - diagrama de clases: vista general

hide members
hide empty methods
skinparam packageStyle rectangle
skinparam nodesep 30
skinparam ranksep 50

package "Presentacion" {
    class WebApp
    class PanelMunicipal <<ADMIN>>
}

package "API (REST y SOAP)" {
    class REST_Reclamos
    class REST_Ciudadanos
    class REST_Cuadrillas
    class REST_ResumenZona
    class REST_Auth
    class SOAP_Reclamos
}

package "Negocio" {
    class Svc_Reclamos <<Facade>>
    class Svc_Ciudadanos
    class Svc_Cuadrillas <<Observer>>
    class Svc_IA <<Observer, Strategy Context>>
    class Svc_Barrios
    class Svc_Auth
}

package "Mensajeria (RabbitMQ)" {
    class Broker <<Sujeto>>
    class Consumidor_Eventos
}

package "Datos" {
    class Repo_Reclamo
    class Repo_Ciudadano
    class Repo_Cuadrilla
    class Repo_Barrio
    class Repo_Usuario
}

package "Dominio" {
    class Reclamo
    class Ciudadano
    class Cuadrilla
    class Barrio
    class Usuario
}

package "Servicios externos" {
    class API_Geo
    class API_LLM
}

WebApp ..> REST_Reclamos
WebApp ..> REST_Ciudadanos
PanelMunicipal ..> REST_Reclamos
PanelMunicipal ..> REST_ResumenZona
PanelMunicipal ..> REST_Cuadrillas
PanelMunicipal ..> REST_Auth

REST_Reclamos ..> Svc_Reclamos
REST_Reclamos ..> Svc_Cuadrillas
REST_Ciudadanos ..> Svc_Ciudadanos
REST_Cuadrillas ..> Svc_Cuadrillas
REST_ResumenZona ..> Svc_IA
REST_Auth ..> Svc_Auth
SOAP_Reclamos ..> Svc_Reclamos

Svc_Reclamos ..> Svc_Barrios
Svc_Reclamos ..> Broker : publica
Svc_Cuadrillas ..> Broker : publica
Svc_IA ..> Broker : publica
Broker ..> Consumidor_Eventos : via colas
Consumidor_Eventos ..> Svc_Cuadrillas : actualizar()
Consumidor_Eventos ..> Svc_IA : actualizar()

Svc_Reclamos --> Repo_Reclamo
Svc_IA --> Repo_Reclamo
Svc_Ciudadanos --> Repo_Ciudadano
Svc_Cuadrillas --> Repo_Cuadrilla
Svc_Barrios --> Repo_Barrio
Svc_Auth --> Repo_Usuario

Repo_Reclamo ..> Reclamo
Repo_Ciudadano ..> Ciudadano
Repo_Cuadrilla ..> Cuadrilla
Repo_Barrio ..> Barrio
Repo_Usuario ..> Usuario

Svc_Reclamos ..> API_Geo
Svc_IA ..> API_LLM

legend right
  Detalle en:
  01a dominio (entidades, value objects, enums)
  01b patrones (Factory, Strategy, Observer, Facade)
  01c servicios (API, negocio, datos, IA, util)
  01d seguridad (Usuario, Rol, JWT, permisos)
  06 flujo de mensajes (colas y routing keys)
endlegend
@enduml
