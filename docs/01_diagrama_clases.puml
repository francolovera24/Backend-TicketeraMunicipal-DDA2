@startuml TicketeraMunicipal

title Ticketera Municipal - diagrama de clases (monolito modular, base de datos compartida)

' ==================== ENTIDADES DE DOMINIO ====================

class Ciudadano {
    -id : String
    -nombre : String
    -contacto : String
    -historialReclamos : List<Reclamo>
    +agregarReclamoAlHistorial(reclamo) : void
}

class Reclamo {
    -id : String
    -descripcion : String
    -tipo : TipoDeReclamo
    -ubicacion : Ubicacion
    -estado : Estado
    -fechaCreacion : Date
    -fechaActualizacion : Date
    -scoreCriticidad : int
    -urgente : boolean
    -reclamoOriginal : Reclamo
    +cambiarEstado(nuevoEstado) : void
    +marcarUrgente() : void
    +marcarDuplicadoDe(original) : void
    +calcularAntiguedad() : int
}

enum Estado {
    NUEVO
    EN_ANALISIS
    ASIGNADO
    EN_PROCESO
    RESUELTO
    RECHAZADO
    DUPLICADO
}

class Barrio {
    -id : String
    -nombre : String
}

class Cuadrilla {
    -id : String
    -especialidad : String
    -disponible : boolean
    +marcarDisponible() : void
    +marcarOcupada() : void
}

class TipoDeReclamo {
    -id : String
    -nombre : String
    -pesoRiesgo : int
}

class ResumenDeZona {
    -barrio : String
    -textoResumen : String
    -timestampGeneracion : Date
}

' ==================== INTERFACES DE PATRONES ====================

interface Sujeto {
    +suscribir(observador) : void
    +desuscribir(observador) : void
    +notificar(evento) : void
}

interface Observador {
    +actualizar(evento) : void
}

interface CriticidadStrategy <<Strategy>> {
    +calcularScore(reclamo, similaresEnZona) : int
    +aplicaA(tipo) : boolean
}

abstract class ScorePorFormula {
    -k : int
    -topeHoras : int
    -m : int
    +calcularScore(reclamo, similaresEnZona) : int
}

class ScoreCableado {
    k=10, tope=48 h, m=5
    +aplicaA(tipo) : boolean
}

class ScoreBacheo {
    k=5, tope=72 h, m=15
    +aplicaA(tipo) : boolean
}

class ScoreGenerico {
    k=5, tope=96 h, m=3
    +aplicaA(tipo) : boolean
}

note bottom of ScorePorFormula
  score = pesoRiesgo*k + min(antiguedadHoras, tope)
          + similaresEnZona*m
  ScoreCableado aplica a CABLEADO, ScoreBacheo a BACHEO.
  ScoreGenerico aplica a todos y va ultima (@Order):
  es el respaldo de ALUMBRADO, ARBOLADO y RUIDOS_MOLESTOS.
end note

abstract class ReclamoFactory <<Factory Method>> {
    +crear(descripcion, ubicacion, barrio, ciudadano) : Reclamo
    #validar(descripcion, ubicacion, barrio, ciudadano) : void
    #{abstract} construir(descripcion, ubicacion, barrio, ciudadano) : Reclamo
    +{abstract} getTipo() : TipoDeReclamo
}

class CableadoReclamoFactory {
    #construir(...) : Reclamo
    +getTipo() : TipoDeReclamo
}

class BacheoReclamoFactory {
    #construir(...) : Reclamo
    +getTipo() : TipoDeReclamo
}

class AlumbradoReclamoFactory {
    #construir(...) : Reclamo
    +getTipo() : TipoDeReclamo
}

class ArboladoReclamoFactory {
    #construir(...) : Reclamo
    +getTipo() : TipoDeReclamo
}

class RuidosReclamoFactory {
    #construir(...) : Reclamo
    +getTipo() : TipoDeReclamo
}

note bottom of ReclamoFactory
  crear() es el metodo plantilla (final):
  validar() -> construir() (hook de cada subclase).
  CableadoReclamoFactory.construir() crea el reclamo
  y lo marca urgente (riesgo electrico); las demas
  lo crean con su tipo. Svc_Reclamos elige la fabrica
  por tipo (mapa TipoDeReclamo -> ReclamoFactory).
end note

' ==================== CAPA PRESENTACION ====================

class WebApp {
    -sesionActual : Ciudadano
    -restClient : RestClient
    +crearReclamo(descripcion, ubicacion) : Reclamo
    +consultarEstado(idReclamo) : Reclamo
    +verHistorial() : List<Reclamo>
}

class PanelMunicipal {
    -usuarioLogueado : String
    -restClient : RestClient
    +gestionarReclamos() : void
    +asignarCuadrilla(idReclamo, idCuadrilla) : void
    +verResumenIA(filtros) : ResumenZona
}

' ==================== CAPA SERVICIOS (monolito modular: modulos de un unico despliegue) ====================

class REST_Reclamos <<REST API>> {
    -svcReclamos : Svc_Reclamos
    +altaReclamo(dto) : Reclamo
    +consultarReclamos(filtros) : List<Reclamo>
    +cambiarEstado(id, estado) : void
}

class REST_ResumenZona <<REST API>> {
    -svcIA : Svc_IA
    +obtenerResumen(barrio, tipo, desde) : ResumenZona
}

class REST_Ciudadanos <<REST API>> {
    -svcCiudadanos : Svc_Ciudadanos
    +altaCiudadano(dto) : Ciudadano
    +consultarCiudadano(id) : Ciudadano
    +obtenerHistorial(id) : List<Reclamo>
}

class SOAP_Reclamos <<SOAP>> {
    -svcReclamos : Svc_Reclamos
    +consultarEstadoReclamo(id) : EstadoReclamo
}

note right of SOAP_Reclamos
  Servicio propio (no legado) para
  integraciones externas. Spring-WS,
  contrato XSD, WSDL en /ws/reclamos.wsdl.
end note


' ==================== CAPA NEGOCIO ====================

class Svc_Reclamos <<Facade>> {
    -repo : Repo_Reclamo
    -broker : Broker
    -factory : ReclamoFactory
    +registrarReclamo(tipo, descripcion, ubicacion) : Reclamo
    +cambiarEstado(id, estado) : void
    +consultarReclamos(filtros) : List<Reclamo>
}

class Svc_Zonas {
    -repo : Repo_Zona
    +agruparPorZona(reclamos) : Map
    +obtenerReclamosDeZona(barrio) : List<Reclamo>
}

class Svc_Cuadrillas <<Observer>> {
    -repo : Repo_Cuadrilla
    -broker : Broker
    +actualizar(evento) : void
    +asignar(reclamo) : void
}

class Svc_IA <<Strategy Context>> {
    -estrategias : List<CriticidadStrategy>
    -repoReclamo : Repo_Reclamo
    -cache : Cache_Resumenes
    -detector : DetectorDeDuplicados
    +calcularScore(reclamo, similaresEnZona) : int
    -estrategiaPara(tipo) : CriticidadStrategy
    +generarResumen(reclamos) : ResumenZona
    +validarReclamo(reclamo) : void
    +actualizar(evento) : void
}

class DetectorDeDuplicados {
    -repoReclamo : Repo_Reclamo
    -radioMetros : int
    -ventanaDias : int
    +buscarOriginal(reclamo) : Reclamo
}

class Svc_Ciudadanos {
    -repo : Repo_Ciudadano
    +registrarCiudadano(nombre, contacto) : Ciudadano
    +consultarCiudadano(id) : Ciudadano
    +obtenerHistorialReclamos(id) : List<Reclamo>
    +actualizarContacto(id, nuevoContacto) : void
}

' ==================== CAPA MENSAJERIA (Event-Driven) ====================

class Evento {
    -eventId : UUID
    -tipo : TipoEvento
    -timestamp : Instant
    -version : int
    -correlationId : String
    -reclamoId : UUID
    -barrio : String
    +{static} de(tipo, reclamoId, barrio) : Evento
}

enum TipoEvento {
    RECLAMO_CREADO : reclamo.creado
    RECLAMO_VALIDADO : reclamo.validado
    RECLAMO_ASIGNADO : reclamo.asignado
    RECLAMO_RESUELTO : reclamo.resuelto
    ZONA_RESUMEN : zona.resumen
}

note right of TipoEvento
  | evento | publica | consume |
  | ReclamoCreado | Svc_Reclamos (alta) | Svc_IA (valida) |
  | ReclamoValidado | Svc_IA | Svc_Cuadrillas (asigna), Svc_IA |
  | ReclamoAsignado | Svc_Cuadrillas (asignar), Svc_Reclamos (PUT estado) | Svc_IA (invalida cache) |
  | ReclamoResuelto | Svc_Reclamos (PUT estado) | Svc_Cuadrillas (libera), Svc_IA |
  | ZonaResumen | Svc_IA | (sin binding) |
  Detalle de colas y bindings: 06_diagrama_flujo_mensajes.
end note

class Broker <<RabbitMQ>> {
    -exchange : String
    +suscribir(observador) : void
    +desuscribir(observador) : void
    +notificar(evento) : void
    +publicar(evento) : void
}

class Consumidor_Eventos <<RabbitListener>> {
    -cola : String
    -observador : Observador
    +recibir(evento) : void
}

' ==================== CAPA DATOS ====================

class Repo_Reclamo {
    -dataSource : DataSource
    +guardar(reclamo) : void
    +buscarPorId(id) : Reclamo
    +filtrar(criterios) : List<Reclamo>
    +buscarCandidatosDuplicado(tipo, desde) : List<Reclamo>
}

class Repo_Zona {
    -dataSource : DataSource
    +guardar(zona) : void
    +buscarPorNombre(nombre) : Zona
}

class Repo_Cuadrilla {
    -dataSource : DataSource
    +guardar(cuadrilla) : void
    +buscarDisponibles(especialidad) : List<Cuadrilla>
}

class Repo_Ciudadano {
    -dataSource : DataSource
    +guardar(ciudadano) : void
    +buscarPorId(id) : Ciudadano
    +buscarPorContacto(contacto) : Ciudadano
}

class Cache_Resumenes {
    -store : Map<String, ResumenZona>
    -ttlMinutos : int
    +get(key) : ResumenZona
    +set(key, valor, ttl) : void
}

' ==================== COMPONENTE DE UTILIDAD (util) ====================

class Validador <<util>> {
    +{static} requerido(valor, campo) : String
    +{static} presente(valor, campo) : T
    +{static} largoMaximo(valor, maximo, campo) : String
    +{static} coordenadas(lat, lon) : void
    +{static} uuid(valor, campo) : UUID
}

class Bitacora <<util>> {
    -logger : Logger
    +{static} de(clase) : Bitacora
    +info(evento, datos) : void
    +aviso(evento, datos) : void
    +error(evento, causa, datos) : void
}

class ConfiguracionTicketera <<util>> {
    -ia : Ia
    -geo : Geo
    -duplicados : Duplicados
}

note bottom of Bitacora
  Wrapper de SLF4J: todos los servicios loguean
  "evento clave=valor ...". ConfiguracionTicketera
  concentra las variables de entorno (sin @Value sueltos).
end note

' ==================== SERVICIOS EXTERNOS ====================

class API_Geo <<API externa>> {
    -baseUrl : String
    +geocodificar(direccion) : Coordenadas
}

class API_LLM <<API externa>> {
    -apiKey : String
    -modelo : String
    +generarTexto(prompt) : String
}


' ==================== NOTAS ====================

note right of Broker
  publicar() envia el evento al exchange
  topic ticketera.eventos de RabbitMQ.
  La entrega a los Observadores la hace
  Consumidor_Eventos desde la cola.
end note

note right of Consumidor_Eventos
  Un @RabbitListener por cola (cuadrillas.eventos,
  ia.eventos). ACK del contenedor al terminar sin
  error, 3 intentos con backoff y luego DLQ.
  Idempotencia: tabla evento_procesado.
end note

note bottom of DetectorDeDuplicados
  1) Reglas: mismo tipo, activo, reciente
     y a menos de radioMetros (o mismo barrio).
  2) Solo si hay candidatos, el LLM decide
     si describen el mismo problema.
  Si el LLM falla: no es duplicado.
end note

note left of Svc_IA
  Flujo de alta:
  reclamo.creado -> Svc_IA.validarReclamo
  - duplicado: estado DUPLICADO + reclamoOriginal
  - si no: publica reclamo.validado
  Svc_Cuadrillas asigna al recibir
  reclamo.validado.
end note

' ==================== RELACIONES DE DOMINIO ====================

Ciudadano "1" --> "N" Reclamo : reporta
Barrio "1" --> "N" Reclamo : agrupa
Cuadrilla "1" --> "N" Reclamo : atiende
Reclamo "N" --> "1" TipoDeReclamo : es de tipo
Reclamo "N" --> "1" Estado : esta en
Reclamo "N" --> "0..1" Reclamo : duplicado de
ResumenDeZona "1" --> "N" Reclamo : ordena

' ==================== RELACIONES DE PATRONES ====================

ReclamoFactory <|-- CableadoReclamoFactory
ReclamoFactory <|-- BacheoReclamoFactory
ReclamoFactory <|-- AlumbradoReclamoFactory
ReclamoFactory <|-- ArboladoReclamoFactory
ReclamoFactory <|-- RuidosReclamoFactory

Sujeto <|.. Broker
Observador <|.. Svc_Cuadrillas
Observador <|.. Svc_IA
CriticidadStrategy <|.. ScorePorFormula
ScorePorFormula <|-- ScoreCableado
ScorePorFormula <|-- ScoreBacheo
ScorePorFormula <|-- ScoreGenerico
Svc_IA o--> "3" CriticidadStrategy : elige la primera que\naplicaA(reclamo.tipo)

' ==================== RELACIONES DE ARQUITECTURA ====================

WebApp ..> REST_Reclamos : usa
WebApp ..> REST_ResumenZona : usa
WebApp ..> REST_Ciudadanos : usa
PanelMunicipal ..> REST_Reclamos : usa
PanelMunicipal ..> REST_ResumenZona : usa
PanelMunicipal ..> REST_Ciudadanos : usa

REST_Reclamos ..> Svc_Reclamos : delega
REST_ResumenZona ..> Svc_IA : delega
REST_Ciudadanos ..> Svc_Ciudadanos : delega
SOAP_Reclamos ..> Svc_Reclamos : delega

Svc_Reclamos --> "5" ReclamoFactory : elige por tipo
Svc_Reclamos ..> Svc_Zonas : usa
Svc_Reclamos ..> Broker : publica evento

Svc_Reclamos --> Repo_Reclamo : usa
Svc_Zonas --> Repo_Zona : usa
Svc_Cuadrillas --> Repo_Cuadrilla : usa
Svc_IA --> Repo_Reclamo : usa
Svc_IA --> Cache_Resumenes : usa
Svc_IA --> DetectorDeDuplicados : usa
Svc_IA ..> Broker : publica reclamo.validado
Svc_Ciudadanos --> Repo_Ciudadano : usa
DetectorDeDuplicados --> Repo_Reclamo : busca candidatos

Svc_Reclamos ..> API_Geo : consulta
Svc_IA ..> API_LLM : consulta
DetectorDeDuplicados ..> API_LLM : compara descripciones

ReclamoFactory ..> Validador : valida con
Svc_Ciudadanos ..> Validador : valida con
SOAP_Reclamos ..> Validador : valida con
Svc_IA ..> ConfiguracionTicketera : lee
DetectorDeDuplicados ..> ConfiguracionTicketera : lee

' ==================== RELACIONES DE MENSAJERIA ====================

Broker ..> Evento : publica
Evento --> TipoEvento
Svc_Cuadrillas ..> Broker : publica reclamo.asignado
Broker ..> Consumidor_Eventos : entrega via cola
Consumidor_Eventos --> Observador : entrega evento

' ==================== RELACIONES ENTRE ARQUITECTURA Y DOMINIO ====================

Svc_Reclamos ..> Reclamo : crea/gestiona
ReclamoFactory ..> Reclamo : instancia
Repo_Reclamo ..> Reclamo : persiste
Repo_Zona ..> Barrio : persiste
Repo_Cuadrilla ..> Cuadrilla : persiste
Repo_Ciudadano ..> Ciudadano : persiste
Svc_Cuadrillas ..> Cuadrilla : gestiona
Svc_Zonas ..> Barrio : gestiona
Svc_IA ..> ResumenDeZona : genera
Svc_IA ..> Reclamo : marca duplicado
Svc_Ciudadanos ..> Ciudadano : gestiona
WebApp ..> Ciudadano : representa a
@enduml
