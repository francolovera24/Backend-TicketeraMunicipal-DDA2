@startuml TicketeraMunicipal

' ==================== ENTIDADES DE DOMINIO ====================

class Ciudadano {
    -id : String
    -nombre : String
    -contacto : String
    -historialReclamos : List<Reclamo>
    +agregarReclamoAlHistorial(reclamo) : void
}

class Reclamo {
    -id : String
    -descripcion : String
    -tipo : TipoDeReclamo
    -ubicacion : Ubicacion
    -estado : String
    -fechaCreacion : Date
    -fechaActualizacion : Date
    -scoreCriticidad : int
    -urgente : boolean
    +cambiarEstado(nuevoEstado) : void
    +marcarUrgente() : void
    +calcularAntiguedad() : int
}

class Barrio {
    -id : String
    -nombre : String
}

class Cuadrilla {
    -id : String
    -especialidad : String
    -disponible : boolean
    +marcarDisponible() : void
    +marcarOcupada() : void
}

class TipoDeReclamo {
    -id : String
    -nombre : String
    -pesoRiesgo : int
}

class ResumenDeZona {
    -barrio : String
    -textoResumen : String
    -timestampGeneracion : Date
}

' ==================== INTERFACES DE PATRONES ====================

interface Sujeto {
    +suscribir(observador) : void
    +desuscribir(observador) : void
    +notificar(evento) : void
}

interface Observador {
    +actualizar(evento) : void
}

interface CriticidadStrategy {
    +calcularScore(reclamo) : int
}

abstract class ReclamoFactory {
    +{abstract} crear(tipo, descripcion, ubicacion) : Reclamo
}

' ==================== CAPA PRESENTACION ====================

class WebApp {
    -sesionActual : Ciudadano
    -restClient : RestClient
    +crearReclamo(descripcion, ubicacion) : Reclamo
    +consultarEstado(idReclamo) : Reclamo
    +verHistorial() : List<Reclamo>
}

class PanelMunicipal {
    -usuarioLogueado : String
    -restClient : RestClient
    +gestionarReclamos() : void
    +asignarCuadrilla(idReclamo, idCuadrilla) : void
    +verResumenIA(filtros) : ResumenZona
}

' ==================== CAPA SERVICIOS (SOA / Microservicios) ====================

class REST_Reclamos <<REST API>> {
    -svcReclamos : Svc_Reclamos
    +altaReclamo(dto) : Reclamo
    +consultarReclamos(filtros) : List<Reclamo>
    +cambiarEstado(id, estado) : void
}

class REST_ResumenZona <<REST API>> {
    -svcIA : Svc_IA
    +obtenerResumen(barrio, tipo, desde) : ResumenZona
}

class REST_Ciudadanos <<REST API>> {
    -svcCiudadanos : Svc_Ciudadanos
    +altaCiudadano(dto) : Ciudadano
    +consultarCiudadano(id) : Ciudadano
    +obtenerHistorial(id) : List<Reclamo>
}

' ==================== CAPA NEGOCIO ====================

class Svc_Reclamos <<Facade>> {
    -repo : Repo_Reclamo
    -broker : Broker
    -factory : ReclamoFactory
    +registrarReclamo(tipo, descripcion, ubicacion) : Reclamo
    +cambiarEstado(id, estado) : void
    +consultarReclamos(filtros) : List<Reclamo>
}

class Svc_Zonas {
    -repo : Repo_Zona
    +agruparPorZona(reclamos) : Map
    +obtenerReclamosDeZona(barrio) : List<Reclamo>
}

class Svc_Cuadrillas <<Observer>> {
    -repo : Repo_Cuadrilla
    -broker : Broker
    +actualizar(evento) : void
    +asignar(reclamo) : void
}

class Svc_IA <<Strategy Context>> {
    -strategy : CriticidadStrategy
    -repoReclamo : Repo_Reclamo
    -cache : Cache_Resumenes
    +calcularScore(reclamo) : int
    +generarResumen(reclamos) : ResumenZona
    +actualizar(evento) : void
}

class Svc_Ciudadanos {
    -repo : Repo_Ciudadano
    +registrarCiudadano(nombre, contacto) : Ciudadano
    +consultarCiudadano(id) : Ciudadano
    +obtenerHistorialReclamos(id) : List<Reclamo>
    +actualizarContacto(id, nuevoContacto) : void
}

' ==================== CAPA MENSAJERIA (Event-Driven) ====================

class Evento {
    -eventId : String
    -tipo : String
    -timestamp : Date
    -correlationId : String
    -reclamoId : String
    -barrio : String
}

class Broker <<RabbitMQ>> {
    -exchange : String
    +suscribir(observador) : void
    +desuscribir(observador) : void
    +notificar(evento) : void
    +publicar(evento) : void
}

class Consumidor_Eventos <<RabbitListener>> {
    -cola : String
    -observador : Observador
    +recibir(evento) : void
}

' ==================== CAPA DATOS ====================

class Repo_Reclamo {
    -dataSource : DataSource
    +guardar(reclamo) : void
    +buscarPorId(id) : Reclamo
    +filtrar(criterios) : List<Reclamo>
}

class Repo_Zona {
    -dataSource : DataSource
    +guardar(zona) : void
    +buscarPorNombre(nombre) : Zona
}

class Repo_Cuadrilla {
    -dataSource : DataSource
    +guardar(cuadrilla) : void
    +buscarDisponibles(especialidad) : List<Cuadrilla>
}

class Repo_Ciudadano {
    -dataSource : DataSource
    +guardar(ciudadano) : void
    +buscarPorId(id) : Ciudadano
    +buscarPorContacto(contacto) : Ciudadano
}

class Cache_Resumenes {
    -store : Map<String, ResumenZona>
    -ttlMinutos : int
    +get(key) : ResumenZona
    +set(key, valor, ttl) : void
}

' ==================== SERVICIOS EXTERNOS ====================

class API_Geo <<API externa>> {
    -baseUrl : String
    +geocodificar(direccion) : Coordenadas
}

class API_LLM <<API externa>> {
    -apiKey : String
    -modelo : String
    +generarTexto(prompt) : String
}

' ==================== NOTAS DE MENSAJERIA ====================

note right of Broker
  publicar() envia el evento al exchange
  topic ticketera.eventos de RabbitMQ.
  La entrega a los Observadores la hace
  Consumidor_Eventos desde la cola.
end note

note right of Consumidor_Eventos
  Lee de su cola de RabbitMQ.
  ACK manual, reintentos y DLQ.
end note

' ==================== RELACIONES DE DOMINIO ====================

Ciudadano "1" --> "N" Reclamo : reporta
Barrio "1" --> "N" Reclamo : agrupa
Cuadrilla "1" --> "N" Reclamo : atiende
Reclamo "N" --> "1" TipoDeReclamo : es de tipo
ResumenDeZona "1" --> "N" Reclamo : ordena

' ==================== RELACIONES DE PATRONES ====================

Sujeto <|.. Broker
Observador <|.. Svc_Cuadrillas
Observador <|.. Svc_IA
CriticidadStrategy <|.. Svc_IA

' ==================== RELACIONES DE ARQUITECTURA ====================

WebApp ..> REST_Reclamos : usa
WebApp ..> REST_ResumenZona : usa
WebApp ..> REST_Ciudadanos : usa
PanelMunicipal ..> REST_Reclamos : usa
PanelMunicipal ..> REST_ResumenZona : usa
PanelMunicipal ..> REST_Ciudadanos : usa

REST_Reclamos ..> Svc_Reclamos : delega
REST_ResumenZona ..> Svc_IA : delega
REST_Ciudadanos ..> Svc_Ciudadanos : delega

Svc_Reclamos --> ReclamoFactory : usa
Svc_Reclamos ..> Svc_Zonas : usa
Svc_Reclamos ..> Broker : publica evento

Svc_Reclamos --> Repo_Reclamo : usa
Svc_Zonas --> Repo_Zona : usa
Svc_Cuadrillas --> Repo_Cuadrilla : usa
Svc_IA --> Repo_Reclamo : usa
Svc_IA --> Cache_Resumenes : usa
Svc_Ciudadanos --> Repo_Ciudadano : usa

Svc_Reclamos ..> API_Geo : consulta
Svc_IA ..> API_LLM : consulta

' ==================== RELACIONES DE MENSAJERIA ====================

Broker ..> Evento : publica
Broker ..> Consumidor_Eventos : entrega via cola
Consumidor_Eventos --> Observador : entrega evento

' ==================== RELACIONES ENTRE ARQUITECTURA Y DOMINIO ====================

Svc_Reclamos ..> Reclamo : crea/gestiona
ReclamoFactory ..> Reclamo : instancia
Repo_Reclamo ..> Reclamo : persiste
Repo_Zona ..> Barrio : persiste
Repo_Cuadrilla ..> Cuadrilla : persiste
Repo_Ciudadano ..> Ciudadano : persiste
Svc_Cuadrillas ..> Cuadrilla : gestiona
Svc_Zonas ..> Barrio : gestiona
Svc_IA ..> ResumenDeZona : genera
Svc_Ciudadanos ..> Ciudadano : gestiona
WebApp ..> Ciudadano : representa a
@enduml
