@startuml
title Resumen priorizado de una zona (GET /resumen-zona)

actor "Panel Municipal" as Panel
participant "REST_ResumenZona" as REST
participant "ManejadorDeErrores\n<<RestControllerAdvice>>" as Errores
participant "Svc_IA\n<<Strategy Context>>" as Svc
participant "Cache_Resumenes" as Cache
participant "Repo_Reclamo" as Repo
participant "CriticidadStrategy" as Strategy
participant "API_LLM" as LLM

Panel -> REST : obtenerResumen(barrio, tipo, desde)

alt falta el barrio, o tipo / desde con formato invalido
    REST -> Errores : MissingServletRequestParameterException /\nMethodArgumentTypeMismatchException
    Errores --> Panel : 400 Bad Request
else barrio inexistente
    REST -> Svc : generarResumen(barrio)
    Svc --> Errores : RecursoNoEncontradoException
    Errores --> Panel : 404 Not Found
else barrio valido
    REST -> Svc : generarResumen(barrio, tipo, desde)
    Svc -> Cache : get("barrio|tipo|desde")
    note right of Cache : la clave incluye los tres filtros\n("*" si no se aplica)

    alt cache vigente (< 5 min)
        Cache --> Svc : ResumenDeZona cacheado
    else cache vencida o vacia
        Svc -> Repo : filtrar(reclamos activos del barrio)
        Repo --> Svc : List<Reclamo>
        Svc -> Svc : contar similares por tipo\n(sobre todos los activos del barrio)
        Svc -> Svc : aplicar filtros tipo y desde\n(desde = inicio del dia, hora de Buenos Aires)

        loop por cada reclamo
            Svc -> Strategy : calcularScore(reclamo, similaresEnZona)
            Strategy --> Svc : score
        end

        Svc -> Svc : ordenarPorScore(reclamos)

        Svc -> Svc : anonimizar(reclamos)
        note right of Svc
          Paso de privacidad (Anonimizador): de cada descripcion
          se quitan nombre y contacto del vecino, emails, DNI y
          telefonos. Al LLM solo van barrio, tipo y descripcion
          anonimizada. El ranking del Panel conserva el original.
        end note

        Svc -> LLM : generarTexto(barrio, reclamosAnonimizados)

        alt LLM responde OK (timeout de lectura 20 s)
            LLM --> Svc : textoResumen
            Svc -> Cache : set("barrio|tipo|desde", resumen, 5 min)
        else LLM falla (error, 503 o timeout)
            note right of Svc : Resiliencia: se muestra solo\nel ranking calculado (generadoPorIa=false)
            Svc -> Svc : usar texto de fallback
            Svc -> Cache : set("barrio|tipo|desde", resumen, 30 s)
            note right of Cache : TTL corto: el proximo pedido\nreintenta el LLM enseguida
        end
    end

    Svc --> REST : ResumenDeZona
    REST --> Panel : 200 OK, JSON (ranking + texto)
end
@enduml
