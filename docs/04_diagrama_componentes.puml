@startuml 04_diagrama_componentes
skinparam componentStyle uml2
skinparam defaultFontSize 11
skinparam nodesep 12
skinparam ranksep 20
skinparam packagePadding 8
skinparam linetype ortho

title Ticketera Municipal - componentes (monolito modular)

package "Capa Presentacion" {
    [WebApp - Portal Vecino] as WebApp
    [PanelMunicipal (rol ADMIN)] as Panel
    [Sistema externo] as Externo
}

package "Capa Servicios (monolito modular: modulos de un unico despliegue)" {
    component "Servicio de Autenticacion" as CompAuth {
        interface "IAuthREST" as IAuth
        [REST_Auth]
        [Svc_Auth]
        [ProveedorJwt]
        [JwtAuthenticationFilter]
    }

    component "Servicio de Reclamos" as CompReclamos {
        interface "IReclamosREST" as IReclamos
        interface "IReclamosSOAP" as ISoap
        [REST_Reclamos]
        [SOAP_Reclamos]
        [Svc_Reclamos <<Facade>>]
        [ReclamoFactory]
        [Svc_Barrios]
    }

    component "Servicio de Ciudadanos" as CompCiudadanos {
        interface "ICiudadanosREST" as ICiudadanos
        [REST_Ciudadanos]
        [Svc_Ciudadanos]
    }

    component "Servicio de Cuadrillas" as CompCuadrillas {
        interface "ICuadrillasREST" as ICuadrillas
        [REST_Cuadrillas]
        [Svc_Cuadrillas <<Observer>>]
        [ConsumidorCuadrillas]
    }

    component "Servicio de IA" as CompIA {
        interface "IResumenZonaREST" as IResumen
        [REST_ResumenZona]
        [Svc_IA <<Strategy, Observer>>]
        [ConsumidorIA]
        [DetectorDeDuplicados]
        [Cache_Resumenes (memoria)]
    }
}

package "Capa Mensajeria" {
    component "Broker de Eventos" as CompBroker {
        interface "IMensajeria" as IMsg
        [Broker <<Sujeto>>]
        [ConsumidorEventos (base comun)]
    }
    queue "RabbitMQ" as MQ
}

package "Capa Datos" {
    [Repo_Reclamo]
    [Repo_Barrio]
    [Repo_Cuadrilla]
    [Repo_Ciudadano]
    [Repo_Usuario]
    database "PostgreSQL" as DB
}

package "Servicios Externos" {
    [API Geolocalizacion (Nominatim)] as Geo
    [API LLM (Gemini)] as LLM
}

' ---- Presentacion -> interfaces ----
WebApp --> IReclamos
WebApp --> ICiudadanos
Panel --> IAuth
Panel --> IReclamos
Panel --> ICuadrillas
Panel --> IResumen
Externo --> ISoap

' ---- Mensajeria ----
CompReclamos --> IMsg : publica eventos
CompCuadrillas --> IMsg : publica y consume
CompIA --> IMsg : publica y consume
CompBroker --> MQ
[ConsumidorCuadrillas] ..> [ConsumidorEventos (base comun)] : reutiliza procesamiento
[ConsumidorIA] ..> [ConsumidorEventos (base comun)] : reutiliza procesamiento
CompReclamos ..> CompCuadrillas : asignacion manual

' ---- Datos ----
CompAuth --> [Repo_Usuario]
CompReclamos --> [Repo_Reclamo]
CompReclamos --> [Repo_Barrio]
CompCiudadanos --> [Repo_Ciudadano]
CompCuadrillas --> [Repo_Cuadrilla]
CompIA --> [Repo_Reclamo]

[Repo_Reclamo] --> DB
[Repo_Barrio] --> DB
[Repo_Cuadrilla] --> DB
[Repo_Ciudadano] --> DB
[Repo_Usuario] --> DB

' ---- Externos ----
CompReclamos --> Geo
CompIA --> LLM

' ---- Orden visual (enlaces invisibles) ----
Panel -[hidden]down- CompReclamos
CompAuth -[hidden]right- CompReclamos
CompCiudadanos -[hidden]right- CompCuadrillas
CompCuadrillas -[hidden]right- CompIA
CompAuth -[hidden]down- CompCiudadanos
CompReclamos -[hidden]down- CompCuadrillas
CompCiudadanos -[hidden]down- [Repo_Reclamo]
CompCuadrillas -[hidden]down- CompBroker
CompIA -[hidden]down- Geo

note right of CompAuth
  JwtAuthenticationFilter valida el
  token de cada request; los endpoints
  de gestion exigen rol ADMIN.
end note
@enduml
