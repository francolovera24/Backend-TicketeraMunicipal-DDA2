@startuml 04_diagrama_componentes
title Ticketera Municipal - componentes (monolito modular)

skinparam componentStyle uml2
skinparam packageStyle rectangle
skinparam defaultFontSize 12
skinparam nodesep 40
skinparam ranksep 60

' ---------------- Clientes ----------------
[WebApp\n(vecino)] as WebApp
[PanelMunicipal\n(operador, rol ADMIN)] as Panel
[Sistema externo] as Externo

' ---------------- Aplicacion ----------------
package "ticketera-backend.jar  (monolito modular, un unico despliegue)" {

    component "Autenticacion\n--\nAuthController, SvcAuth,\nProveedorJwt, filtro JWT" as Auth
    component "Reclamos\n--\nREST y SOAP, SvcReclamos (Facade),\nReclamoFactory, SvcBarrios" as Reclamos
    component "Ciudadanos\n--\nCiudadanoController,\nSvcCiudadanos" as Ciudadanos
    component "Cuadrillas\n--\nCuadrillaController,\nSvcCuadrillas (Observer)" as Cuadrillas
    component "IA\n--\nSvcIA (Strategy, Observer),\nDetectorDeDuplicados,\nCache de resumenes" as IA

    component "Mensajeria\n--\nBroker (Sujeto),\nConsumidorEventos" as Mensajeria
    component "Persistencia\n--\nRepositorios Spring Data,\nmigraciones Flyway" as Datos
}

' ---------------- Infraestructura y externos ----------------
database "PostgreSQL" as DB
queue "RabbitMQ" as MQ
cloud "Nominatim" as Geo
cloud "Gemini (LLM)" as LLM

' ---------------- Clientes -> modulos ----------------
WebApp --> Reclamos : POST /reclamos
WebApp --> Ciudadanos : /ciudadanos
WebApp --> Auth : /auth
Panel --> Auth : login
Panel --> Reclamos : gestion de reclamos
Panel --> Cuadrillas : /cuadrillas
Panel --> IA : /resumen-zona
Externo --> Reclamos : SOAP /ws

' ---------------- Entre modulos ----------------
Reclamos ..> Cuadrillas : asignacion manual
Reclamos --> Mensajeria : publica
Cuadrillas --> Mensajeria : publica / consume
IA --> Mensajeria : publica / consume

Auth --> Datos
Reclamos --> Datos
Ciudadanos --> Datos
Cuadrillas --> Datos
IA --> Datos

' ---------------- Hacia afuera ----------------
Datos --> DB : JDBC
Mensajeria --> MQ : AMQP
Reclamos --> Geo : HTTPS
IA --> LLM : HTTPS

' Orden visual de las filas
Auth -[hidden]right- Reclamos
Reclamos -[hidden]right- Ciudadanos
Ciudadanos -[hidden]right- Cuadrillas
Cuadrillas -[hidden]right- IA
Mensajeria -[hidden]right- Datos

legend bottom
  Todas las requests pasan por el filtro JWT; los endpoints de gestion exigen rol ADMIN.
  Todos los modulos usan util (Validador, Bitacora, Anonimizador, ConfiguracionTicketera).
  Detalle de colas: 06_diagrama_flujo_mensajes. Clases: 01 a 01d.
endlegend
@enduml
