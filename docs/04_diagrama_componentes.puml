@startuml
skinparam componentStyle uml2
skinparam defaultFontSize 11
skinparam nodesep 12
skinparam ranksep 20
skinparam packagePadding 8

title Ticketera Municipal - componentes (monolito modular)

package "Capa Presentacion" {
    [WebApp - Portal Vecino] as WebApp
    [PanelMunicipal] as Panel
}

[Sistemas externos\n(integraciones)] as Externos

package "Aplicacion: ticketera-backend.jar (monolito modular, un unico despliegue)" {

    package "Seguridad (Spring Security, JWT)" {
        component "Modulo Autenticacion" as CompAuth {
            interface "IAuthREST" as IAuth
            [REST_Auth]
            [Svc_Auth]
            [ProveedorJwt]
            [JwtAuthenticationFilter] as Filtro
        }
    }

    package "Capa Servicios (modulos)" {
        component "Modulo Reclamos" as CompReclamos {
            interface "IReclamosREST" as IReclamos
            interface "IReclamosSOAP" as ISoap
            [REST_Reclamos]
            [SOAP_Reclamos]
            [Svc_Reclamos <<Facade>>]
            [ReclamoFactory]
        }

        component "Modulo Ciudadanos" as CompCiudadanos {
            interface "ICiudadanosREST" as ICiudadanos
            [REST_Ciudadanos]
            [Svc_Ciudadanos]
        }

        component "Modulo Cuadrillas" as CompCuadrillas {
            interface "ICuadrillasREST" as ICuadrillas
            [REST_Cuadrillas]
            [Svc_Cuadrillas <<Observer>>]
        }

        component "Modulo IA" as CompIA {
            interface "IResumenZonaREST" as IResumen
            [REST_ResumenZona]
            [Svc_IA <<Strategy>>]
            [DetectorDeDuplicados]
            [Cache_Resumenes (en memoria)] as Cache
        }
    }

    package "Capa Mensajeria" {
        component "Broker de Eventos" as CompBroker {
            interface "IMensajeria" as IMsg
            [Broker <<Sujeto>>]
            [ConsumidorEventos]
        }
    }

    package "Capa Datos" {
        [Repo_Reclamo]
        [Repo_Barrio]
        [Repo_Cuadrilla]
        [Repo_Ciudadano]
        [Repo_Usuario]
    }

    package "Componente de utilidad (util)" {
        component "Utilidades" as CompUtil {
            [Validador]
            [Bitacora (logging SLF4J)]
            [ConfiguracionTicketera]
        }
    }
}

database "PostgreSQL\n(base compartida por todos los modulos)" as DB
queue "RabbitMQ\n(exchange ticketera.eventos)" as MQ
database "Redis\n(reservado, sin uso)" as Redis

package "Servicios Externos" {
    [API Geolocalizacion] as Geo
    [API LLM] as LLM
}

note bottom of CompIA
  Candidato a separarse primero si el sistema
  evoluciona a microservicios (ver CLAUDE.md,
  "Arquitectura: decision de despliegue").
end note

WebApp --> IReclamos
WebApp --> IResumen
WebApp --> ICiudadanos
Panel --> IReclamos
Panel --> IResumen
Panel --> ICiudadanos
Panel --> ICuadrillas
Panel --> IAuth : login (JWT de rol ADMIN)
WebApp --> IAuth : registro / login (opcional)
Filtro ..> CompReclamos : autentica (Bearer)
Filtro ..> CompIA : autentica (Bearer)
Filtro ..> CompCiudadanos : autentica (Bearer)
CompAuth --> [Repo_Usuario]
[Repo_Usuario] --> DB
CompReclamos ..> CompCuadrillas : asignar-cuadrilla\n(llamada en proceso)

note right of CompAuth
  Rol ADMIN requerido (@PreAuthorize) en: GET /reclamos,
  PUT estado, PUT asignar-cuadrilla, GET /resumen-zona,
  GET /ciudadanos/{id}/reclamos. El alta de reclamos,
  la consulta por id, /auth, Swagger y SOAP son publicos.
end note
Externos --> ISoap : SOAP (consulta de estado)

CompReclamos --> IMsg : publica eventos
CompCuadrillas --> IMsg : publica y consume eventos
CompIA --> IMsg : publica y consume eventos
CompBroker --> MQ : AMQP

CompReclamos --> [Repo_Reclamo]
CompCuadrillas --> [Repo_Cuadrilla]
CompCiudadanos --> [Repo_Ciudadano]
CompIA --> [Repo_Reclamo]

[Repo_Reclamo] --> DB
[Repo_Barrio] --> DB
[Repo_Cuadrilla] --> DB
[Repo_Ciudadano] --> DB

CompReclamos --> Geo
CompIA --> LLM

CompReclamos ..> CompUtil : usa
CompCiudadanos ..> CompUtil : usa
CompCuadrillas ..> CompUtil : usa
CompIA ..> CompUtil : usa
CompBroker ..> CompUtil : usa
@enduml
