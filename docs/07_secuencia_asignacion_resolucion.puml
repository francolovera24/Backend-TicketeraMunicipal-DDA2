@startuml
title Proceso de negocio: asignacion -> trabajo -> resolucion (continua 02_secuencia_reclamo_creado)

actor "Operador municipal\n(usuario ADMIN)" as Operador
participant PanelMunicipal as Panel
participant "REST_Reclamos" as REST
participant "ManejadorDeErrores\n<<RestControllerAdvice>>" as Errores
participant "Svc_Reclamos\n<<Facade>>" as Svc
participant "Broker\n<<Sujeto>>" as Broker
participant "Consumidor_Eventos\n(cuadrillas.eventos)" as ConsCuad
participant "Svc_Cuadrillas\n<<Observer>>" as Cuadrillas
participant "Repo_Cuadrilla" as RepoCuad
participant "Repo_Reclamo" as Repo
participant "Consumidor_Eventos\n(ia.eventos)" as ConsIA
participant "Svc_IA\n<<Observer>>" as IA

== Asignacion automatica (tras la validacion de 02) ==

Broker -> ConsCuad : ReclamoValidado
ConsCuad -> Cuadrillas : actualizar(ReclamoValidado)
Cuadrillas -> RepoCuad : buscarDisponibles(especialidad)\n(bloquea la fila)

alt hay una cuadrilla libre de la especialidad
    RepoCuad --> Cuadrillas : cuadrilla
    Cuadrillas -> Cuadrillas : cuadrilla.marcarOcupada()\nreclamo.asignarCuadrilla(cuadrilla)
    note right of Cuadrillas : estado NUEVO -> ASIGNADO
    Cuadrillas -> Broker : publicar(ReclamoAsignado)
    Broker -> ConsIA : ReclamoAsignado
    ConsIA -> IA : actualizar(ReclamoAsignado)
    note right of IA : invalida la cache\nde esa zona
else no hay cuadrillas libres
    RepoCuad --> Cuadrillas : ninguna
    note right of Cuadrillas : el reclamo queda NUEVO,\npendiente de asignacion
end

== Asignacion manual (alternativa, desde el Panel) ==

note over Panel, REST
  ASIGNADO requiere una cuadrilla: PUT /reclamos/{id}/estado (ASIGNADO)
  devuelve 409. La asignacion manual usa el endpoint siguiente.
end note

Operador -> Panel : asignarCuadrilla(idReclamo, idCuadrilla)
Panel -> REST : GET /cuadrillas?especialidad=X&disponible=true
REST --> Panel : cuadrillas libres
Panel -> REST : PUT /reclamos/{id}/asignar-cuadrilla (cuadrillaId)
REST -> Cuadrillas : asignarCuadrilla(id, cuadrillaId)
Cuadrillas -> RepoCuad : buscarConBloqueo(cuadrillaId)

alt reclamo o cuadrilla inexistente
    Cuadrillas --> Errores : RecursoNoEncontradoException
    Errores --> Panel : 404 Not Found
else cuadrilla ocupada, de otra especialidad,\no reclamo que no espera asignacion
    Cuadrillas --> Errores : ConflictoException / TransicionInvalidaException
    Errores --> Panel : 409 Conflict
else asignacion valida
    Cuadrillas -> Cuadrillas : reclamo.asignarCuadrilla(cuadrilla)\ncuadrilla.marcarOcupada()
    Cuadrillas -> Broker : publicar(ReclamoAsignado)
    Cuadrillas --> REST : reclamo ASIGNADO
    REST --> Panel : 200 OK
end

== Trabajo en curso ==

note over Panel, REST
  Todos los pedidos del Panel llevan "Authorization: Bearer <token>"
  de un usuario ADMIN (ver 08_secuencia_autenticacion). Sin token -> 401;
  con rol VECINO -> 403 (@PreAuthorize en cambiarEstado y asignarCuadrilla).
end note

Operador -> Panel : marcar en proceso
Panel -> REST : PUT /reclamos/{id}/estado (EN_PROCESO)
REST -> Svc : cambiarEstado(id, EN_PROCESO)
Svc -> Repo : buscarPorId(id)

alt reclamo inexistente
    Repo --> Svc : vacio
    Svc --> Errores : RecursoNoEncontradoException
    Errores --> Panel : 404 Not Found
else transicion no permitida (ej. desde NUEVO o DUPLICADO)
    Repo --> Svc : reclamo
    Svc --> Errores : TransicionInvalidaException
    Errores --> Panel : 409 Conflict
else transicion valida
    Repo --> Svc : reclamo
    Svc -> Svc : reclamo.cambiarEstado(EN_PROCESO)
    Svc -> Broker : publicar(ReclamoEstadoCambiado)\n(se envia despues del commit)
    Broker -> ConsIA : ReclamoEstadoCambiado
    ConsIA -> IA : actualizar(ReclamoEstadoCambiado)
    note right of IA : invalida las variantes\ndel resumen del barrio
    Svc --> REST : reclamo
    REST --> Panel : 200 OK
end

== Resolucion ==

note over Svc, IA
  EN_ANALISIS y RECHAZADO tambien publican ReclamoEstadoCambiado.
  Al consumir el evento, la proxima consulta recalcula el resumen.
  Un reclamo RECHAZADO deja de contar como activo.
end note

Operador -> Panel : marcar resuelto
Panel -> REST : PUT /reclamos/{id}/estado (RESUELTO)
REST -> Svc : cambiarEstado(id, RESUELTO)
Svc -> Svc : reclamo.cambiarEstado(RESUELTO)
Svc -> Broker : publicar(ReclamoResuelto)\n(se envia despues del commit)
Svc --> REST : reclamo
REST --> Panel : 200 OK

par cola cuadrillas.eventos
    Broker -> ConsCuad : ReclamoResuelto
    ConsCuad -> Cuadrillas : actualizar(ReclamoResuelto)
    Cuadrillas -> Cuadrillas : cuadrilla.marcarDisponible()
    Cuadrillas -> Repo : reclamo pendiente mas antiguo\nde esa especialidad
    opt hay un reclamo pendiente
        Repo --> Cuadrillas : pendiente
        Cuadrillas -> Cuadrillas : asignar(pendiente)
        Cuadrillas -> Broker : publicar(ReclamoAsignado)
    end
else cola ia.eventos
    Broker -> ConsIA : ReclamoResuelto
    ConsIA -> IA : actualizar(ReclamoResuelto)
    note right of IA : invalida la cache;\nel reclamo sale del ranking
end
@enduml
