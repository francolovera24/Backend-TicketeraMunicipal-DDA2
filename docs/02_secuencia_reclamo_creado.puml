@startuml
title Alta de un reclamo y validacion asincronica (sigue en 07_secuencia_asignacion_resolucion)

actor Vecino
participant WebApp
participant "REST_Reclamos" as REST
participant "ManejadorDeErrores\n<<RestControllerAdvice>>" as Errores
participant "Svc_Reclamos\n<<Facade>>" as Svc
participant "ReclamoFactory" as Factory
participant "Repo_Reclamo" as Repo
participant "Broker\n<<Sujeto>>" as Broker
participant "Consumidor_Eventos\n<<RabbitListener>>" as Consumidor
participant "Svc_IA\n<<Observer>>" as IA
participant "DetectorDeDuplicados" as Detector
participant "API_LLM" as LLM
participant "Svc_Cuadrillas\n<<Observer>>" as Cuadrillas

Vecino -> WebApp : crearReclamo(descripcion, ubicacion)
WebApp -> REST : altaReclamo(dto)

alt dto invalido (Bean Validation: campos vacios, tipo inexistente)
    REST -> Errores : MethodArgumentNotValidException
    Errores --> WebApp : 400 Bad Request (problem+json con los campos)
else dto valido
    REST -> Svc : registrarReclamo(tipo, descripcion, ubicacion)
    Svc -> Factory : crear(tipo, descripcion, ubicacion)
    Factory -> Factory : validar(...) con Validador

    alt regla de validacion incumplida (ej. coordenadas fuera de rango, sin barrio)
        Factory --> Errores : ValidacionException
        Errores --> WebApp : 400 Bad Request
    else ciudadano inexistente
        Svc --> Errores : RecursoNoEncontradoException
        Errores --> WebApp : 404 Not Found
    else datos correctos
        Factory --> Svc : reclamo
        Svc -> Repo : guardar(reclamo)
        Repo --> Svc : ok
        Svc -> Broker : publicar(ReclamoCreado)\n(se envia despues del commit)
        Svc --> REST : reclamo creado (NUEVO)
        REST --> WebApp : 201 Created
        WebApp --> Vecino : confirmacion
    end
end

== Validacion asincronica (cola ia.eventos) ==

Broker -> Consumidor : entrega via cola
Consumidor -> IA : actualizar(ReclamoCreado)
note right of IA : invalida la cache\nde esa zona
IA -> Detector : buscarOriginal(reclamo)
Detector -> Repo : buscarCandidatosDuplicado(tipo, desde)
Repo --> Detector : candidatos
Detector -> Detector : filtrar por distancia / barrio

alt hay candidatos
    Detector -> LLM : generarTexto(nuevo, candidatos)
    alt LLM responde
        LLM --> Detector : numero del duplicado o 0
    else LLM falla
        note right of Detector : se considera\nno duplicado
    end
end
Detector --> IA : original o ninguno

alt es duplicado
    IA -> Repo : marcarDuplicadoDe(original)
    note right of IA : estado DUPLICADO,\nno se asigna cuadrilla
else no es duplicado
    IA -> Repo : guardar score inicial
    IA -> Broker : publicar(ReclamoValidado)

    == Asignacion (cola cuadrillas.eventos) ==

    Broker -> Consumidor : entrega via cola
    Consumidor -> Cuadrillas : actualizar(ReclamoValidado)
    Cuadrillas -> Cuadrillas : asignar(reclamo)
end
@enduml
